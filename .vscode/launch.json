{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(lldb) Launch",
            "type": "lldb",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "stopOnEntry": false,
            "cwd": "${command:cmake.getLaunchTargetDirectory}",
            "env": {
                "PATH": "${env:PATH}:${command:cmake.getLaunchTargetDirectory}"
            },
            "terminal": "integrated"
        },
        {
            "name": "(ctest) Launch",
            "type": "lldb",
            "request": "launch",
            "cwd": "${command:cmake.testWorkingDirectory}",
            "program": "${command:cmake.testProgram}",
            "args": [
                "${cmake.testArgs}"
            ],
            "stopOnEntry": true,
            "env": {
                "PATH": "${env:PATH}:${command:cmake.getLaunchTargetDirectory}"
            },
            "terminal": "integrated"
        }
    ]
}